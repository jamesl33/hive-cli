[Unit]
Description=Close the radiator valve of each warm room
Documentation=https://github.com/jamesl33/hive-cli/tree/master/deploy/systemd
Wants=network-online.target time-sync.target
After=network-online.target time-sync.target mosquitto.service zigbee2mqtt.service

[Service]
EnvironmentFile=-/etc/hive/env
# TRVs hold their last opening if the service dies, so open them all again whenever it stops.
ExecStart=/usr/local/bin/hive control
ExecStopPost=/usr/local/bin/hive control --restore
Restart=always
RestartSec=30s
User=hive
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
CapabilityBoundingSet=
Nice=10
MemoryMax=64M

[Install]
WantedBy=multi-user.target
