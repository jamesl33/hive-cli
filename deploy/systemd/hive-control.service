[Unit]
Description=Set the radiator valve of each room from its temperature
Documentation=https://github.com/jamesl33/hive-cli/tree/master/deploy/systemd
Wants=network-online.target time-sync.target
After=network-online.target time-sync.target mosquitto.service zigbee2mqtt.service

[Service]
Type=oneshot
EnvironmentFile=-/etc/hive/env
Environment=HIVE_HISTORY=/var/lib/hive
# hive record holds readings in memory for up to 10 minutes; SIGUSR1 makes it write them out first
ExecStartPre=+/usr/bin/systemctl kill --kill-whom=main --signal=SIGUSR1 hive-record.service
ExecStartPre=/bin/sleep 15
ExecStart=/usr/local/bin/hive control
TimeoutStartSec=2min
User=hive
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
CapabilityBoundingSet=
Nice=10
MemoryMax=64M
