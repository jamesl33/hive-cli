# Copy to /etc/hive/env (mode 600). Only needed if Mosquitto isn't anonymous on localhost:1883.
#HIVE_BROKER=tcp://localhost:1883
#HIVE_USERNAME=hive
#HIVE_PASSWORD=changeme

# Also record the gas used from the Octopus smart meter (half hourly, about a day late). m3 for SMETS2, kwh for SMETS1.
#OCTOPUS_API_KEY=sk_live_changeme
#OCTOPUS_MPRN=1234567890
#OCTOPUS_GAS_SERIAL=E6S12345678901
#OCTOPUS_GAS_UNITS=m3

# Likewise for the electricity used (always kWh).
#OCTOPUS_MPAN=1234567890123
#OCTOPUS_ELECTRICITY_SERIAL=21E1234567
