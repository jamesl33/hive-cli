# Copy to /etc/hive/env (mode 600). Only needed if Mosquitto isn't anonymous on localhost:1883.
#HIVE_BROKER=tcp://localhost:1883
#HIVE_USERNAME=hive
#HIVE_PASSWORD=changeme

# Drop to a floor temperature while this device (its Wi-Fi MAC) is off the network. Needs the arp-scan package.
#HIVE_AWAY_MAC=aa:bb:cc:dd:ee:ff
#HIVE_AWAY_FLOOR=14
# Seconds unseen before it counts as away
#HIVE_AWAY_AFTER=1800

# Also record the gas used from the Octopus smart meter (half hourly, about a day late). Assumes a SMETS2 meter, which reports m3.
#OCTOPUS_API_KEY=sk_live_changeme
#OCTOPUS_GAS_MPRN=1234567890
#OCTOPUS_GAS_SERIAL=E6S12345678901

# Likewise for the electricity used (always kWh).
#OCTOPUS_ELECTRICITY_MPAN=1234567890123
#OCTOPUS_ELECTRICITY_SERIAL=21E1234567
