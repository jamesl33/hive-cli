#!/bin/sh
# Set the Hive thermostat to whatever the schedule says for right now.
#
# Reads "HH:MM <temp|off>" lines from $HIVE_SCHEDULE_WEEKDAY (default /etc/hive/schedule.weekday), or on
# Saturday and Sunday from $HIVE_SCHEDULE_WEEKEND (default /etc/hive/schedule.weekend) when that
# file exists. Picks the latest
# slot at or before the current time (wrapping to the last slot of the day before midnight's first
# slot), then runs 'hive manual <temp>' or 'hive off'. Running it twice is harmless, so it is safe
# to call from a timer, after a reboot, or by hand.
#
# When HIVE_AWAY_MAC is set and hive-presence hasn't seen it for HIVE_AWAY_AFTER seconds (default
# 1800), temps above HIVE_AWAY_FLOOR (default 14) are lowered to it. 'off' slots stay off.

set -eu

schedule=${HIVE_SCHEDULE_WEEKDAY:-/etc/hive/schedule.weekday}
weekend=${HIVE_SCHEDULE_WEEKEND:-/etc/hive/schedule.weekend}
presence=${HIVE_PRESENCE_FILE:-/var/lib/hive/away-last-seen}
floor=${HIVE_AWAY_FLOOR:-14}
away_after=${HIVE_AWAY_AFTER:-1800}
now=$(date +%H%M)

# Away when hive-presence has not seen $HIVE_AWAY_MAC for $away_after seconds. A missing file
# counts as home, so a broken probe never cools the house.
is_away() {
	[ -n "${HIVE_AWAY_MAC:-}" ] || return 1
	[ -e "$presence" ] || return 1
	seen=$(stat -c %Y "$presence") || return 1
	[ $(($(date +%s) - seen)) -gt "$away_after" ]
}

if [ "$(date +%u)" -ge 6 ] && [ -r "$weekend" ]; then
	schedule=$weekend
fi

current=""
last=""
current_slot=""
last_slot=""

while read -r slot value _; do
	case "$slot" in
		'' | \#*) continue ;;
	esac

	case "$slot" in
		[0-2][0-9]:[0-5][0-9]) ;;
		*) echo "hive-schedule: bad time '$slot' in $schedule" >&2; exit 2 ;;
	esac

	hm=$(echo "$slot" | tr -d :)
	last=$value
	last_slot=$slot

	# Prefix with 1 so 0930 can never be read as octal
	if [ "1$hm" -le "1$now" ]; then
		current=$value
		current_slot=$slot
	fi
done <"$schedule"

if [ -z "$last" ]; then
	echo "hive-schedule: no slots in $schedule" >&2
	exit 2
fi

# Before the first slot of the day, yesterday's last slot still applies
if [ -z "$current" ]; then
	current=$last
	current_slot=$last_slot
fi

if [ "$current" != "off" ] && is_away && awk -v t="$current" -v f="$floor" 'BEGIN { exit !(t + 0 > f + 0) }'; then
	echo "hive-schedule: away, $current_slot slot wanted ${current}°C"
	current=$floor
fi

if [ "$current" = "off" ]; then
	echo "hive-schedule: $current_slot slot -> off"
	exec hive off
fi

echo "hive-schedule: $current_slot slot -> ${current}°C"
exec hive manual "$current"
